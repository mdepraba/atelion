{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../modules/pdf/web/tsconfig.lib.json"
    },
    {
      "path": "../../modules/fiscus/web/tsconfig.lib.json"
    },
    {
      "path": "../../modules/devtools/tsconfig.lib.json"
    },
    {
      "path": "../../core/ui/tsconfig.lib.json"
    }
  ]
}
